// =============================================================================
// midi_player.ino
// MIDI-to-ESP32 Player — plays monophonic melodies via passive buzzer (PWM)
//
// Hardware:
//   - ESP32 (any variant)
//   - Passive buzzer on BUZZER_PIN
//   - Tactile button on BUTTON_PIN (external pull-down resistor required)
//
// Wiring:
//   Button  → GPIO 14  (+) | GND (−) | 10kΩ pull-down to GND
//   Buzzer  → GPIO 13  (+) | GND (−)
//
// Note: change BUZZER_PIN to 27 when using real hardware instead of simulator.
// =============================================================================

// ── Pin configuration ────────────────────────────────────────────────────────
#define BUTTON_PIN  14    // tactile button (external pull-down)
#define BUZZER_PIN  13    // passive buzzer (PWM output)
                          // → use pin 27 on physical hardware

// ── PWM configuration ────────────────────────────────────────────────────────
#define PWM_FREQ_INIT  1500   // initial PWM carrier frequency (Hz)
#define PWM_RESOLUTION    8   // PWM resolution in bits (0-255)

// ── Timing ───────────────────────────────────────────────────────────────────
#define NOTE_ON_RATIO   0.9f  // fraction of duration spent playing the note
#define NOTE_OFF_RATIO  0.1f  // fraction of duration used as inter-note gap
#define START_DELAY_MS  2000  // delay between button press and playback start

// ── State ────────────────────────────────────────────────────────────────────
bool active = false;

// =============================================================================
// playNote — emit a single tone via PWM
//   freq     : frequency in Hz  (0 = silence)
//   duration : total note duration in milliseconds
// =============================================================================
void playNote(int freq, int duration) {
  Serial.print("Note: ");
  Serial.print(freq);
  Serial.print(" Hz  |  duration: ");
  Serial.print(duration);
  Serial.println(" ms");

  ledcWriteTone(BUZZER_PIN, freq);
  delay((int)(duration * NOTE_ON_RATIO));

  ledcWriteTone(BUZZER_PIN, 0);        // brief silence between notes
  delay((int)(duration * NOTE_OFF_RATIO));
}

