// =============================================================================
// setup
// =============================================================================
void setup() {
  Serial.begin(115200);

  pinMode(BUTTON_PIN, INPUT);           // external pull-down resistor on board
  ledcAttach(BUZZER_PIN, PWM_FREQ_INIT, PWM_RESOLUTION);

  Serial.println("[System] Ready — press button to start playback");
}

// =============================================================================
// loop
// =============================================================================
void loop() {
  int state = digitalRead(BUTTON_PIN);

  // Uncomment to debug button state:
  // Serial.print("[Button] State: "); Serial.println(state);

  // Pull-down wiring: HIGH = button pressed
  if (state == HIGH && !active) {
    active = true;
    Serial.print("[Button] Pressed — starting in ");
    Serial.print(START_DELAY_MS / 1000);
    Serial.println(" s...");

    delay(START_DELAY_MS);
    playMusic();

    active = false;
  }

  delay(200);   // debounce / reduce serial spam
}
